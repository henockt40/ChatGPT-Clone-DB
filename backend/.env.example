# Copy this file to backend/.env. Do NOT commit .env.
PORT=3777
FRONTEND_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=YOUR_MYSQL_USER
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=chatgpt_clone
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
AI_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_WITH_PRIVATE_GEMINI_KEY
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=
GEMINI_MAX_ATTEMPTS=3

# Image generation may require a billed Gemini API account.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
